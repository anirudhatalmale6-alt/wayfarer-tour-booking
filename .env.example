# Copy to .env and adjust. Every value here has a working default.
PORT=4021
DB_PATH=data/wayfarer.db

# Checkout window: how long seats are held while a traveller fills the form.
HOLD_MINUTES=15

# How close to departure online booking stops.
BOOKING_CUTOFF_DAYS=2

# Parties larger than this are handled by hand, not through the form.
MAX_SEATS_PER_BOOKING=12

# demo | stripe   (demo cannot charge a real card)
PAYMENT_GATEWAY=demo

# Only read by the stripe adapter, which is a documented stub today.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
